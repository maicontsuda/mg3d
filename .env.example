# Supabase
# A publishable key is exposed to the browser and protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxx
# Private server key used to validate and register orders with canonical prices.
SUPABASE_SERVICE_ROLE_KEY=eyJ...private...

# WhatsApp checkout
# Digits only, including country code. Example for Japan: 819012345678
NEXT_PUBLIC_WHATSAPP_NUMBER=819012345678

# Cloudinary uploads (private Vercel Environment Variables)
CLOUDINARY_CLOUD_NAME=xxxxxxxxx
CLOUDINARY_API_KEY=xxxxxxxxxxxxxxx
CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxx
MG3D_ADMIN_UPLOAD_KEY=use-a-long-random-secret

# Customer status notifications (optional, private server variables)
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL=MG3D <pedidos@seu-dominio-verificado.com>

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_FROM=+14155238886

# Customer phone is stored in Supabase customers.phone in E.164 format, e.g. +819012345678
