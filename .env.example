# ============================================================================
# MG3D — variáveis de ambiente
# Copie para .env.local (desenvolvimento) e configure as mesmas no Vercel.
# Só as NEXT_PUBLIC_* chegam ao navegador; as demais são privadas.
# ============================================================================

# ---------------------------------------------------------------- Supabase
NEXT_PUBLIC_SUPABASE_URL=https://kzfbiyygbjrhjlbdsxsd.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
# Alternativa antiga ao nome acima (uma das duas basta)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...public...
# PRIVADA: usada pelas rotas de servidor (checkout, webhook, newsletter)
SUPABASE_SERVICE_ROLE_KEY=eyJ...private...

# ------------------------------------------------------------------- Site
NEXT_PUBLIC_SITE_URL=https://mg3d.vercel.app
# Precisa ser idêntico ao e-mail usado em public.is_mg3d_admin() (supabase/schema.sql)
NEXT_PUBLIC_ADMIN_EMAIL=maicontsuda@gmail.com
# E-mail exibido para dúvidas de clientes (padrão: o mesmo do admin)
# NEXT_PUBLIC_CONTACT_EMAIL=contato@mg3d.com

# ----------------------------------------------------------------- Stripe
STRIPE_SECRET_KEY=sk_test_xxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxx
